# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real tokens.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=
# Comma-separated; get them with: python -m backend.telegram_setup chats
TELEGRAM_CHAT_IDS=

# Optional: the three AI agents (Thermal, Seal, Incident) use Gemini. Get a key at https://aistudio.google.com/apikey
# then check it with:  .venv\Scripts\python -m backend.gemini_check
# GEMINI_API_KEY=
# FREE TIER ONLY: keep the project without a billing account. The default is a Flash-Lite model (15/min, 500/day free).
# GEMINI_MODEL=gemini-3.5-flash-lite
# The backend keeps itself under the free limits (60 % per minute, 80 % per day, counted in data/gemini_usage.json) and
# pauses AI calls after any 429; the rule-based text is used meanwhile. Override only if you know your limits:
# COLDTRUST_GEMINI_RPM=
# COLDTRUST_GEMINI_RPD=
# Camera frames contain people; the free Gemini tier lets Google use submitted content, so frames stay off unless you set:
# COLDTRUST_VISION=on
# Telegram: ONE message per alert, the AI agent's analysis (rule-based text if the AI is late or unavailable).
# Set COLDTRUST_TELEGRAM_AI=0 to always send the rule-based text at once. Seconds an alert waits for the AI:
# COLDTRUST_TELEGRAM_AI=1
# COLDTRUST_TELEGRAM_AI_WAIT_S=5
# Alternative provider: ANTHROPIC_API_KEY=  with  COLDTRUST_LLM_PROVIDER=anthropic

# Login: an admin account switches it on (the driver account is optional). Sign in with the company ID and the password.
# Passwords (the variable names still end in _CODE): at least 8 characters, different from each other. NAME is what the audit log shows (defaults to the ID).
# No admin account = open access, no login.
# COLDTRUST_ADMIN_ID=ADM-1001
# COLDTRUST_ADMIN_NAME=Your Name
# COLDTRUST_ADMIN_CODE=
# COLDTRUST_DRIVER_ID=DRV-20418
# COLDTRUST_DRIVER_NAME=Driver Name
# COLDTRUST_DRIVER_CODE=
# COLDTRUST_SESSION_HOURS=12
# Phone or email shown next to each person in the incident report (left empty, the report says "not set").
# COLDTRUST_ADMIN_CONTACT=+60 12-000 0000
# COLDTRUST_DRIVER_CONTACT=driver@example.com

# Required for real hardware (the backend refuses the default): the firmware must use the same value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# COLDTRUST_SECRET=
