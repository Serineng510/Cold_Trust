# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real tokens.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=
# Comma-separated; get them with: python -m backend.telegram_setup chats
TELEGRAM_CHAT_IDS=

# Optional: the three AI agents (Thermal, Seal, Incident) use Gemini. Get a key at https://aistudio.google.com/apikey
# then check it with:  .venv\Scripts\python -m backend.gemini_check
# GEMINI_API_KEY=
# FREE TIER ONLY: keep the project without a billing account. The default is a Flash-Lite model (15/min, 500/day free).
# GEMINI_MODEL=gemini-3.5-flash-lite
# The backend keeps itself under the free limits (60 % per minute, 80 % per day, counted in data/gemini_usage.json) and
# pauses AI calls after any 429; the rule-based text is used meanwhile. Override only if you know your limits:
# COLDTRUST_GEMINI_RPM=
# COLDTRUST_GEMINI_RPD=
# Camera frames contain people; the free Gemini tier lets Google use submitted content, so frames stay off unless you set:
# COLDTRUST_VISION=on
# Alternative provider: ANTHROPIC_API_KEY=  with  COLDTRUST_LLM_PROVIDER=anthropic

# Required for real hardware (the backend refuses the default): the firmware must use the same value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# COLDTRUST_SECRET=
